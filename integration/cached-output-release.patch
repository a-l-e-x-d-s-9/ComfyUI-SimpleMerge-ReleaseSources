+        source = self.output_cache.get_local(node_id, output_index)
+        for consumer_id in self.pendingNodes:
+            inputs = self.dynprompt.get_node(consumer_id)["inputs"]
+            linked_indices = set()
+            for value in inputs.values():
+                if not is_link(value):
