+        for node_id, indices in outputs.items():
+            self.output_release_requests.setdefault(node_id, set()).update(indices)
+        if on_release is not None:
+            self.output_release_callbacks.append(on_release)
+        if retire_previous_outputs:
+            self.previous_output_release_requests.setdefault(self.staged_node_id, set()).update(retire_previous_outputs)
+
+    def _output_has_pending_consumer(self, node_id, output_index):
