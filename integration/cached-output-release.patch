+        if any(index < 0 or index >= len(self.outputs) for index in output_indices):
+            raise IndexError("Invalid cached output index")
+        outputs = list(self.outputs)
+        for index in output_indices:
+            outputs[index] = []
+        return type(self)(self.ui, outputs, released=self.released | output_indices, producer=self.producer)
 
 
